{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/suivi-retraits/dist/public",
  "installCommand": "corepack enable && corepack prepare pnpm@8 --activate && pnpm install --no-frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs24.x"
    }
  }
}
